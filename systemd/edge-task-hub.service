[Unit]
Description=Edge Task Hub Web Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pi3/edge-task-hub
Environment=PATH=/home/pi3/edge-task-hub/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=ENABLE_OPENCLAW=false
Environment=ENABLE_OLLAMA=false
Environment=ENABLE_ANOMALY_MODEL=true
Environment=ANOMALY_SAMPLE_INTERVAL_SECONDS=300
Environment=NEWS_SUMMARY_MODE=auto
Environment=NEWS_SUMMARY_MODEL=qwen3:1.7b
Environment=NEWS_SUMMARY_TIMEOUT_SECONDS=300
Environment=NEWS_SUMMARY_MAX_TOKENS=160
Environment=MODEL_SPEED_TARGET_SECONDS=30
Environment=OLLAMA_CANDIDATE_MODELS=qwen3:1.7b,qwen3:0.6b,qwen3.5:0.8b,qwen2.5:0.5b-instruct,tinyllama,llama3.2:1b
Environment=OLLAMA_MODEL=qwen3:0.6b
Environment=OLLAMA_NUM_CTX=1024
Environment=OLLAMA_KEEP_ALIVE=0
Environment=DOCUMENT_SUMMARY_MODEL=qwen2.5:0.5b-instruct
Environment=DOCUMENT_SUMMARY_TIMEOUT_SECONDS=180
Environment=DOCUMENT_SUMMARY_MAX_TOKENS=160
Environment=DOCUMENT_SUMMARY_MAX_CHARS=4000
Environment=DOCUMENT_SUMMARY_MAX_FILE_BYTES=8388608
Environment=OPENCLAW_CLI=/home/pi3/.npm-global/bin/openclaw
Environment=OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MALLOC_ARENA_MAX=2
ExecStart=/home/pi3/edge-task-hub/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
