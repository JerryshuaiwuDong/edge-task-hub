# Lark/Feishu custom bot webhook URL (required for outbound notifications)
FEISHU_WEBHOOK_URL=REPLACE_ME

# SQLite database path (default: data/edge_task_hub.db)
# DATABASE_URL=sqlite:////home/pi3/edge-task-hub/data/edge_task_hub.db

# Default timezone for new tasks
DEFAULT_TIMEZONE=Asia/Shanghai

# Server bind
HOST=0.0.0.0
PORT=8000

# Optional integrations are off by default so the Pi keeps memory for the main app.
ENABLE_OPENCLAW=false
ENABLE_OLLAMA=false

# TinyML / classical ML anomaly detection.
ENABLE_ANOMALY_MODEL=true
ANOMALY_SAMPLE_INTERVAL_SECONDS=300

# Model/news behavior.
NEWS_SUMMARY_MODE=auto
NEWS_SUMMARY_MODEL=qwen3:1.7b
NEWS_SUMMARY_TIMEOUT_SECONDS=300
NEWS_SUMMARY_MAX_TOKENS=160
MODEL_SPEED_TARGET_SECONDS=30
OLLAMA_CANDIDATE_MODELS=qwen3:1.7b,qwen3:0.6b,qwen3.5:0.8b,qwen2.5:0.5b-instruct,tinyllama,llama3.2:1b

# Ollama benchmark/runtime defaults. keep_alive=0 unloads the model after each call.
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_NUM_CTX=1024
OLLAMA_KEEP_ALIVE=0
OPENCLAW_CLI=/home/pi3/.npm-global/bin/openclaw
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789

# Feishu inbound app events. These are for text reminder commands and private document files.
FEISHU_INBOUND_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ALLOWED_OPEN_IDS=
FEISHU_ALLOWED_CHAT_IDS=

# Private document summaries run locally on Ollama.
DOCUMENT_SUMMARY_MODEL=qwen3:1.7b
DOCUMENT_SUMMARY_TIMEOUT_SECONDS=300
DOCUMENT_SUMMARY_MAX_TOKENS=240
DOCUMENT_SUMMARY_MAX_CHARS=12000
DOCUMENT_SUMMARY_MAX_FILE_BYTES=8388608
